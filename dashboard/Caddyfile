# dashboard: the built app, served as static files on the internal network. The reverse proxy
# in front terminates TLS and routes /api and /ws to the API.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode gzip
	# Client-side routes (/twin…) all load the app.
	try_files {path} /index.html
	file_server
	# Vite fingerprints what it builds under /assets: cache it for good.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
}
