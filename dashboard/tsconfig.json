{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      // The wire contract is the backend's own source: one definition, no build step.
      "@sentinel-x/contract": ["../backend/src/contract.ts"],
      // ...and the zod it imports is ours, whether or not backend/node_modules exists.
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["src", "smoke", "vite.config.ts", "playwright.config.ts"]
}
