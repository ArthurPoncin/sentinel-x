# The vision service's settings — copy to vision.env (or export them) and fill in. Never commit the copy.
# An empty variable counts as unset: its default applies.

# Where the frames come from: opencv:<webcam index>, opencv:<path of a video file, played in a loop>, or
# picamera2, the Pi's ZIF camera (only in the Pi's image, with docker-compose.camera.yml).
CAMERA_SOURCE=opencv:0
# What finds the intruder: tflite (EfficientDet-Lite0, a person detector) or motion (OpenCV background subtraction).
DETECTOR=motion
# Infer on every Nth frame only (1–30); the feed stays at the camera's rate.
INFER_EVERY=1
# Detections less sure than this are ignored (0–1). For tflite, the model's score for "person" (0.5 as
# upstream); for motion, 0.5 = a blob half the size of a person.
MIN_CONFIDENCE=0.5
# tflite only: the model, fetched with vision/fetch_model.py (the image holds it there), and its CPU threads.
TFLITE_MODEL=/models/efficientdet_lite0.tflite
TFLITE_THREADS=4
# tflite only: run the model only while the motion detector sees something, or did, or the model saw a
# person, in the last MOTION_GATE_HOLD_S seconds (0.5–60).
MOTION_GATE=false
MOTION_GATE_HOLD_S=3

# The lens's horizontal field of view, in degrees (10–170): what turns a place across the image into an angle.
# The same as the Twin's (SITE.camera.fov, dashboard/src/features/twin/utils/site.ts).
CAMERA_FOV_DEG=60
# What turns the camera to the person it follows: none (a fixed camera), pwm, a servo on one of the Pi's
# hardware PWM pins (docker-compose.pan.yml), or stepper, a 28BYJ-48 stepper motor on its ULN2003 board, on
# four of the Pi's GPIOs (docker-compose.stepper.yml). Needs a person detector: with DETECTOR=motion the
# camera stays fixed.
PAN_DRIVE=none
# pwm and stepper: the motor's travel either way of where the camera rests (degrees, positive toward the
# right of its image), whether it is mounted the other way up, how fast it turns at most (degrees a second:
# 40 for the stepper, which manages about 44) and how far off the middle of the image it leaves the person
# be (degrees). pwm only: the PWM channel's directory and the pulse at each end of the travel (microseconds).
PAN_PWM_DIR=/sys/class/pwm/pwmchip0/pwm0
PAN_MIN_DEG=-90
PAN_MAX_DEG=90
PAN_MIN_US=500
PAN_MAX_US=2500
PAN_INVERT=false
PAN_SPEED_DEG_S=60
PAN_DEADBAND_DEG=4
# pwm and stepper, with no intrusion: how long it waits where it lost the person before going back to where it
# rests (seconds, after CLEAR_AFTER_S), then how far it looks around from there, either way (degrees: 0 stays
# where it rests), and how fast (degrees a second: slowly, so that the image does not blur).
PAN_HOME_AFTER_S=2
PAN_PATROL_DEG=30
PAN_PATROL_SPEED_DEG_S=8
# stepper only: the GPIO chip, the board's IN1 to IN4 on the Pi's GPIOs, the half-steps of a turn of the
# motor's shaft (4096 through its gears) and the pause after each half-step (milliseconds: shorter, it
# misses some).
PAN_GPIO_CHIP=/dev/gpiochip0
PAN_STEPPER_PINS=6,13,19,26
PAN_STEPS_PER_TURN=4096
PAN_STEP_MS=2

# POST /api/v1/alerts, and the token the api knows as VISION_TOKEN (32 characters or more: openssl rand -hex 32).
ALERTS_URL=http://api:8080/api/v1/alerts
VISION_TOKEN=
# The Sentinel the camera's Alerts are filed under.
VISION_SENTINEL=sentinel-01
# An intrusion is cleared once nobody has been seen for this many seconds.
CLEAR_AFTER_S=3

# The feed (/) and /health. 0.0.0.0 in the container, on the internal network only; 127.0.0.1 on a laptop.
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
# Pictures a second per client (1–15), clients at once (1–16), JPEG quality (10–100).
STREAM_FPS=15
MAX_CLIENTS=4
JPEG_QUALITY=80
