# The vision service's settings — copy to vision.env (or export them) and fill in. Never commit the copy.
# An empty variable counts as unset: its default applies.

# Where the frames come from: opencv:<webcam index>, opencv:<path of a video file, played in a loop>, or
# picamera2, the Pi's ZIF camera (only in the Pi's image, with docker-compose.camera.yml).
CAMERA_SOURCE=opencv:0
# What finds the intruder: tflite (EfficientDet-Lite0, a person detector) or motion (OpenCV background subtraction).
DETECTOR=motion
# Infer on every Nth frame only (1–30); the feed stays at the camera's rate.
INFER_EVERY=1
# Detections less sure than this are ignored (0–1). For tflite, the model's score for "person" (0.5 as
# upstream); for motion, 0.5 = a blob half the size of a person.
MIN_CONFIDENCE=0.5
# tflite only: the model, fetched with vision/fetch_model.py (the image holds it there), and its CPU threads.
TFLITE_MODEL=/models/efficientdet_lite0.tflite
TFLITE_THREADS=4
# tflite only: run the model only while the motion detector sees something, or did, or the model saw a
# person, in the last MOTION_GATE_HOLD_S seconds (0.5–60).
MOTION_GATE=false
MOTION_GATE_HOLD_S=3

# POST /api/v1/alerts, and the token the api knows as VISION_TOKEN (32 characters or more: openssl rand -hex 32).
ALERTS_URL=http://api:8080/api/v1/alerts
VISION_TOKEN=
# The Sentinel the camera's Alerts are filed under.
VISION_SENTINEL=sentinel-01
# An intrusion is cleared once nobody has been seen for this many seconds.
CLEAR_AFTER_S=3

# The feed (/) and /health. 0.0.0.0 in the container, on the internal network only; 127.0.0.1 on a laptop.
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
# Pictures a second per client (1–15), clients at once (1–16), JPEG quality (10–100).
STREAM_FPS=15
MAX_CLIENTS=4
JPEG_QUALITY=80
