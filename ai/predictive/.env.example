# The predictive service. Copy to .env and fill in; never commit .env: it holds the broker password
# and the service's token. Under Docker Compose they come from infra/secrets/predictive.env, made by
# infra/setup.sh. Every variable is required unless it shows a default.

# The broker, MQTTS only: the broker has no plaintext listener. From the Compose network it is
# mosquitto:8883, the name its certificate carries (DNS:mosquitto). Port 8883 by default.
MQTT_URL=mqtts://mosquitto:8883
# Its own MQTT account: the broker's ACL lets it read sentinel/+/telemetry, nothing else.
MQTT_USERNAME=predictive
# From infra/secrets/handover.txt.
MQTT_PASSWORD=
# The team CA (PEM) that signed the broker's certificate: the broker is verified against it, and
# against nothing else. In the container: infra/secrets/ca.crt mounted read-only.
MQTT_CA_FILE=/certs/ca.crt

# Where it posts its Alerts, on the internal network.
ALERTS_URL=http://api:8080/api/v1/alerts
# Its bearer token on POST /api/v1/alerts, 32 characters or more: the same value as
# PREDICTIVE_TOKEN in the api's environment (infra/secrets/api.env).
PREDICTIVE_TOKEN=

# The model `python -m predictive train` writes. The service starts without it, scores nothing and
# says so, then loads it as soon as it appears, and again each time it changes.
MODEL_FILE=/model/model.joblib
# How often MODEL_FILE is checked, in seconds.
MODEL_POLL_S=10
