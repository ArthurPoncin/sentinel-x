{
  "name": "@sentinel-x/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Command Post API: Alert pipeline, Status, WebSocket feed",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.3",
    "fastify": "^5.12.5",
    "mqtt": "^5.16.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "aedes": "^1.2.0",
    "selfsigned": "^5.5.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}
