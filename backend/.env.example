# Command Post API. Copy to .env (`npm run dev` and `npm start` read it; Compose: `env_file: .env`)
# and fill in. Never commit .env: it holds the broker password, the service tokens and the Operator's password hash. A variable set in the environment
# wins over the file. Every variable is optional unless said otherwise.

# Listen address: 0.0.0.0 to be reached from other machines or containers, 127.0.0.1 otherwise.
HOST=127.0.0.1
PORT=8080

# Origins of the front-ends served elsewhere than the API, comma-separated: scheme, host and port,
# no path. Leave empty when the dashboard and the Twin go through the reverse proxy (the Pi) or the
# Vite proxy (dev): the browser then calls its own origin and needs no CORS.
# On the Pi, if they are served on their own: https://192.168.X.1 (X = table number).
CORS_ORIGINS=http://localhost:5173

# SQLite file of the history, created with its directory if missing. :memory: keeps it in the
# process only. In the container: /data/history.sqlite, on a volume.
HISTORY_FILE=data/history.sqlite

# Scripted scenario in a loop (gas leak, clap, intruder), for the front-ends without a Sentinel.
# It is recorded like the rest: point HISTORY_FILE to :memory: or a file of its own.
MOCK_FEED=false
MOCK_FEED_INTERVAL_MS=1000

# The Operator's password hash: `npm run -s hash-password`. Required, unless OPERATOR_AUTH=off,
# which lets anyone in without logging in (development only).
# OPERATOR_PASSWORD_HASH=
# OPERATOR_AUTH=off

# Bearer token of each AI service on POST /api/v1/alerts, 32 characters or more, one per service:
# `openssl rand -hex 32`. Give each service its own in its environment. Unset: it cannot post.
# VISION_TOKEN=
# PREDICTIVE_TOKEN=

# Broker shared with the Sentinels. Unset: no telemetry in, no command out. MQTTS only.
# The host must be one the broker certificate names: mosquitto inside Compose, 192.168.X.1 outside.
# MQTT_URL=mqtts://mosquitto:8883
# MQTT_USERNAME=api
# Required with MQTT_URL. The api user's password in the broker's password file.
# MQTT_PASSWORD=
# Required with MQTT_URL. The team CA certificate (PEM) that signed the broker's.
# MQTT_CA_FILE=/run/secrets/ca.crt
